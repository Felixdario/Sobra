# Copie para apps/api/.env (lido pela API e pelo prisma.config.ts). Todas têm padrão em dev.

NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# SQLite (padrão em dev e testes). Caminho relativo a apps/api.
DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (docker-compose.yml na raiz). Exige trocar o provider para "postgresql" e o adapter
# para @prisma/adapter-pg, e gerar migrations próprias — ver ADR-010 em docs/decisoes.md.
# DATABASE_URL="postgresql://sobra:sobra@localhost:5432/sobra?schema=public"

# Obrigatório em produção (mínimo 32 caracteres). Em dev/teste há um padrão inseguro.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Origens liberadas no CORS, separadas por vírgula (web Vite e Expo web).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Limite por IP nas rotas /auth/register, /auth/login e /auth/refresh.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

# Custo do argon2: production (OWASP, padrão) ou test (mínimo, só para a suíte; createTestApp já
# usa). Recusado com NODE_ENV=production.
ARGON2_PROFILE=production
