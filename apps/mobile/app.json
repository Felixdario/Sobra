{
  "expo": {
    "name": "Sobra",
    "slug": "financas",
    "version": "0.0.0",
    "scheme": "financas",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F1F1EE",
    "ios": {
      "supportsTablet": false,
      "infoPlist": { "CADisableMinimumFrameDurationOnPhone": true }
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Sobra"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1F1EE",
          "dark": { "backgroundColor": "#141413" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
