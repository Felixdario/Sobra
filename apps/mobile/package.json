{
  "name": "@sobra/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "web": "expo start --web"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|lucide-react-native|react-native-reanimated|react-native-worklets|react-native-gesture-handler))"
    ],
    "resolver": "<rootDir>/jest.resolver.js",
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "^./installUIRuntimeBindings$": "<rootDir>/node_modules/react-native-gesture-handler/src/handlers/gestures/installUIRuntimeBindings.web.ts"
    }
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@hookform/resolvers": "^7.0.2",
    "@sobra/client": "workspace:*",
    "@sobra/i18n": "workspace:*",
    "@sobra/shared": "workspace:*",
    "@sobra/tokens": "workspace:*",
    "@tanstack/react-query": "^5.105.3",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.68.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3"
  }
}
